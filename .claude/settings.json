{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git switch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(.venv/bin/python src/prueba_humo.py*)",
      "Bash(.venv/bin/python -m pytest*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(git rm*)",
      "Bash(.venv/bin/pip install *)",
      "Bash(pip install *)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git config*)",
      "Read(.streamlit/secrets.toml)"
    ]
  }
}
